    {
      "name": "Auth",
      "description": "Authentication endpoints. Login is public; it returns a signed JWT used by all protected requests.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let res = {};",
                  "try { res = pm.response.json(); } catch (e) {}",
                  "",
                  "pm.test('Response contains a token', function () {",
                  "  pm.expect(res).to.have.property('token');",
                  "});",
                  "",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  pm.collectionVariables.set('token_expires_at', res.expires_at || '');",
                  "  if (res.user && res.user.id) {",
                  "    pm.collectionVariables.set('userId', res.user.id);",
                  "  }",
                  "  console.log('Saved token to collection variable (expires ' + res.expires_at + ')');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates a user with email and password and returns a signed JWT.\n\nOn success, this request stores `token`, `token_expires_at`, and `userId` as collection variables for use by subsequent requests."
          },
          "response": [
            {
              "name": "200 - Authenticated",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"expires_at\": \"2026-08-11T01:02:19+07:00\",\n  \"user\": {\n    \"id\": \"3f2504e0-4f89-11d3-9a0c-0305e82c3301\",\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\"\n  }\n}"
            }
